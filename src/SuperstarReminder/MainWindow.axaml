<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SuperstarReminder.MainWindow" Width="1080" Height="740" MinWidth="780" MinHeight="540" Title="Superstar Reminder" Icon="/Assets/app.ico">
 <Grid RowDefinitions="Auto,Auto,*" Background="#10131B">
  <Border Background="#191E2B" Padding="24,20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="SUPERSTAR" Foreground="#E6B544" FontSize="12" LetterSpacing="3"/><TextBlock Text="Make time for yourself." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Small reminders. A memorable entrance." Foreground="#AAB5CC"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="Settings" Click="SettingsClicked"/><Button Content="+ New reminder" Click="NewClicked" Background="#E6B544" Foreground="#171717"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Margin="20,16,20,0" Padding="14" Background="#202A35" CornerRadius="10"><TextBlock x:Name="StatusText" Text="Connecting to MySQL…" TextWrapping="Wrap" Foreground="#BBD9C9"/></Border>
  <Grid Grid.Row="2" ColumnDefinitions="220,*" Margin="20">
   <Border Padding="16" Background="#171C27" CornerRadius="12"><StackPanel Spacing="12"><TextBlock Text="YOUR DESKTOP COMPANION" FontSize="11" Foreground="#9AA7C2"/><TextBlock Text="Superstar Reminder" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Primary monitor · Silent by default" TextWrapping="Wrap" Foreground="#AAB5CC"/><Button Content="Preview character" Click="PreviewClicked"/><Button x:Name="PauseButton" Content="Pause reminders" Click="PauseClicked"/><Separator/><TextBlock Text="Yes celebrates and runs across the screen. No and Snooze take the short walk back." TextWrapping="Wrap" Foreground="#AAB5CC" FontSize="12"/><TextBlock Text="Closing this window keeps reminders running. Use Quit to exit." TextWrapping="Wrap" Foreground="#AAB5CC" FontSize="12"/><Button Content="Quit application" Click="QuitClicked"/></StackPanel></Border>
   <TabControl Grid.Column="1" Margin="16,0,0,0">
    <TabItem Header="Reminders"><Grid RowDefinitions="*,Auto"><ListBox x:Name="ReminderList" Background="Transparent"/><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"><Button Content="Edit" Click="EditClicked"/><Button Content="Enable / Disable" Click="ToggleClicked"/><Button Content="Delete…" Click="DeleteClicked"/><Button Content="Refresh" Click="RefreshClicked"/></StackPanel></Grid></TabItem>
    <TabItem Header="Response history"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><TextBox x:Name="HistoryFilter" Watermark="Filter by title or outcome" TextChanged="HistoryFilterChanged"/><Button Grid.Column="1" Content="Refresh history" Click="RefreshClicked"/></Grid><ListBox Grid.Row="1" x:Name="HistoryList" Background="Transparent"/></Grid></TabItem>
   </TabControl>
  </Grid>
 </Grid>
</Window>
